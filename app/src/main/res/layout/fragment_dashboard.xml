<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?attr/colorSurface"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
      android:id="@+id/tvLastSynced"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="마지막 동기화: -"
      android:textAppearance="@style/TextAppearance.Material3.BodySmall"
      android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      style="@style/Widget.Material3.CardView.Elevated">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="총 수면 (어제)"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
          android:id="@+id/tvHeroTotal"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="—"
          android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
          android:textColor="?attr/colorOnSurface"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvHeroWindow"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="수면 구간: —"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipQuality"
          style="@style/Widget.Material3.Chip.Assist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="—" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      style="@style/Widget.Material3.CardView.Elevated">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="수면 단계"
          android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
          android:textColor="?attr/colorOnSurface" />

        <LinearLayout
          android:id="@+id/stageBar"
          android:layout_width="match_parent"
          android:layout_height="10dp"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

          <View
            android:id="@+id/segDeep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/colorPrimary" />

          <View
            android:id="@+id/segRem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/colorSecondary" />

          <View
            android:id="@+id/segLight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/colorTertiary" />

          <View
            android:id="@+id/segAwake"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/colorError" />
        </LinearLayout>

        <TextView
          android:id="@+id/tvStagesLine"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="데이터 없음"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
          android:id="@+id/rowStages"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:orientation="vertical">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="깊은 수면"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

              <TextView
                android:id="@+id/tvDeepValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="렘 수면"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

              <TextView
                android:id="@+id/tvRemValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="얕은 수면"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

              <TextView
                android:id="@+id/tvLightValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="깨어있음"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

              <TextView
                android:id="@+id/tvAwakeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      style="@style/Widget.Material3.CardView.Elevated">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="오늘의 인사이트"
          android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
          android:textColor="?attr/colorOnSurface" />

        <TextView
          android:id="@+id/tvInsight"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:maxLines="2"
          android:text="—"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      style="@style/Widget.Material3.CardView.Elevated">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="최근 7일 요약"
          android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
          android:textColor="?attr/colorOnSurface" />

        <TextView
          android:id="@+id/tvWeeklyAvg"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="평균 수면: —"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurface" />

        <TextView
          android:id="@+id/tvWeeklyEfficiency"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="수면 효율: —"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurface" />

        <TextView
          android:id="@+id/tvWeeklyRegularity"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="규칙성: —"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurface" />

        <TextView
          android:id="@+id/tvWeeklyDebt"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="수면 부채: —"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurface" />

        <TextView
          android:id="@+id/tvWeeklyTrend"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="추세: —"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
          android:id="@+id/tvWeeklyData"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="데이터: —"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      style="@style/Widget.Material3.CardView.Elevated">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="내 최적 수면"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

          <com.google.android.material.chip.Chip
            android:id="@+id/chipOptimalConfidence"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신뢰도: —" />
        </LinearLayout>

        <TextView
          android:id="@+id/tvOptimalTarget"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="목표 수면: —"
          android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
          android:textColor="?attr/colorOnSurface"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvOptimalBedtime"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="취침 윈도우: —"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
          android:id="@+id/tvOptimalWake"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="기상 윈도우: —"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="왜 이렇게 추천?"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="?attr/colorOnSurface" />

        <TextView
          android:id="@+id/tvOptimalWhyShort"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:maxLines="3"
          android:text="—"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
          android:id="@+id/tvOptimalWhyLong"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="—"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="?attr/colorOnSurfaceVariant"
          android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnOptimalWhyToggle"
          style="@style/Widget.Material3.Button.TextButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="자세히" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="18dp"
      android:text="활동 (어제)"
      android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
      android:textColor="?attr/colorOnSurface" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">

      <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Widget.Material3.CardView.Filled">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="14dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="걸음"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

          <TextView
            android:id="@+id/tvStepsValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <Space
        android:layout_width="10dp"
        android:layout_height="wrap_content" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Widget.Material3.CardView.Filled">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="14dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="거리"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

          <TextView
            android:id="@+id/tvDistanceValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">

      <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Widget.Material3.CardView.Filled">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="14dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="활동 칼로리"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

          <TextView
            android:id="@+id/tvCaloriesValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <Space
        android:layout_width="10dp"
        android:layout_height="wrap_content" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Widget.Material3.CardView.Filled">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="14dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="운동"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

          <TextView
            android:id="@+id/tvWorkoutsValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="18dp"
      android:text="최근 30일"
      android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
      android:textColor="?attr/colorOnSurface" />

    <TextView
      android:id="@+id/tvRecentState"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="불러오는 중..."
      android:textAppearance="@style/TextAppearance.Material3.BodySmall"
      android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvRecent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:nestedScrollingEnabled="false" />

    <Space
      android:layout_width="match_parent"
      android:layout_height="14dp" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
